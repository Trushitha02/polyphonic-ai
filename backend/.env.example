# Copy to backend/.env and fill in. Never commit the real .env file.
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=polyphonic_instrument_db
# DB_HOST=localhost        # setting DB_HOST/DATABASE_URL/DB_TYPE disables the SQLite fallback
# DB_TYPE=sqlite           # force the local SQLite database
# DATABASE_URL=postgres://user:pass@host/db   # Render PostgreSQL
